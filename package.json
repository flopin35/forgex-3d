{
  "name": "forgex-3d",
  "private": true,
  "version": "0.2.0",
  "description": "FORGEX 3D: a personal Windows 3D modelling studio for game assets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cube-test": "vitest run src/core/geometry/cubeTest.test.ts",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp": "node mcp/forgex-mcp.cjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "mcp:bundle": "node scripts/bundle-mcp.mjs",
    "mcp:tools": "UPDATE_MCP_TOOLS=1 vitest run src/core/automation/mcpTools.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "~0.172.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "~0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
